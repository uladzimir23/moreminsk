# Build-context hygiene (монорепо): в образ сайта нужны только apps/site/ +
# infra/nginx/container.conf. Корень тяжёлый (docs-волт, сырьё, tooling) — режем.

# Зависимости и build-выводы (ставятся/генерятся внутри образа)
**/node_modules
apps/site/.next
apps/site/out
apps/admin/dist
.next
out
pocketbase/pb_data
pocketbase/pocketbase

# VCS / CI / редакторы / приватка
.git
.github
.vscode
.idea
.claude
.claude-code

# Docs-волт, корневой tooling, сырьё — не нужны для сборки сайта
docs
tools
raw-media
# infra/ — НЕ игнорируем целиком: Dockerfile копирует infra/nginx/container.conf
infra/server
infra/hosting

# env / логи / ОС-мусор
**/.env
**/.env.*
*.log
bun-error.log
.DS_Store

README.md
CLAUDE.md
