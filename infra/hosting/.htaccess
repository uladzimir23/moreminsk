# Apache config for the Next.js static export on hoster.by shared hosting.
# Lives in public/ → Next copies it into out/ → uploaded to the domain docroot.
# Site is a static export (output: "export", trailingSlash: true): каждая
# страница — папка с index.html, роутинг отдаёт mod_dir/DirectoryIndex, никаких
# rewrite-правил под SPA не нужно.

# ─── HTTPS + canonical host (www → apex) ─────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. HTTP_HOST сохраняем, чтобы не терять www на этом шаге.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Канонический хост — без www. www.more-minsk.by → more-minsk.by.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ─── 404 ─────────────────────────────────────────────────────────────────────
# next export кладёт кастомную страницу в /404.html.
ErrorDocument 404 /404.html

# ─── Кэш ─────────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Хэшированные ассеты Next (/_next/static/**) — immutable, год.
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Картинки — сутки.
  <FilesMatch "\.(png|jpe?g|webp|avif|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # HTML — без кэша, чтобы деплой распространялся сразу.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # sitemap/robots — час.
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# ─── gzip ────────────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    application/rss+xml image/svg+xml
</IfModule>

# Не отдавать листинги директорий.
Options -Indexes
