# Copy to .env.local and fill in. NEXT_PUBLIC_* vars are inlined into the
# static bundle at build time.
#
# Заявки с сайта → PocketBase leads (@moreminsk/pb-client). Уведомления в
# Telegram шлёт PB-хук pocketbase/pb_hooks/leads-telegram.pb.js (env-переменные
# TG_BOT_TOKEN / TG_CHAT_IDS задаются на VPS, см. infra/server/docker-compose.yml).

# URL инстанса PocketBase на билд-тайме (используется pb:export снапшотами
# контента + submitLead с фолбэком на production admin.more-minsk.by).
PB_URL=https://admin.more-minsk.by
