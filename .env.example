# Copy to .env.local and fill in. NEXT_PUBLIC_* vars are inlined into the
# static bundle at build time.

# Endpoint the booking form POSTs leads to. Deploy the relay in
# infra/booking-telegram-worker (forwards to Telegram), or point at Formspree /
# any webhook that accepts JSON. If unset, the form shows a phone fallback.
NEXT_PUBLIC_BOOKING_ENDPOINT=
